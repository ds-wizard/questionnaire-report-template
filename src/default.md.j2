{%- autoescape false -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  VARIABLES                                                                           -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- set dc = ctx|to_context_obj -%}
{%- from "src/dates.j2" import formatDate, formatDateTime -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  TAGS, REFERENCES, and EXPERTS MACROS                                                 -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro renderTags(question) -%}
{%- if question.tags|length > 0 %}
* 🏷️ **{% trans %}Tags:{% endtrans %}** {% for tag in question.tags %}*{{tag.name}}*{% if not loop.last %}, {% endif %}{% endfor %}
{%- endif %}
{%- endmacro -%}
{%- macro renderResourcePageReferences(question) -%}
{% set refs = [] %}
{% for ref in question.resource_page_references %}
{% if ref.resource_page_uuid and ref.resource_page and ref.resource_page.collection %}
{% do refs.append({
    'ref_uuid': ref.uuid,
    'uuid': ref.resource_page_uuid,
    'collection_title': ref.resource_page.collection.title,
    'title': ref.resource_page.title,
}) %}
{% endif %}
{% endfor %}
{% if refs|length > 0 %}
* 📖 **{% trans %}Resource Pages:{% endtrans %}** {% for ref in refs %}{%- set resourcePageLink = dc.config.client_url ~ '/knowledge-models/' ~ dc.pkg.id ~ '/resource-pages/' ~ ref.uuid -%}[{{ ref.collection_title }} - {{ ref.title }}]({{resourcePageLink}}){% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}
{%- endmacro -%}
{%- macro renderURLReferences(question) -%}
{% set refs = [] %}
{% for ref in question.url_references %}
{% if ref.label and ref.url %}
{% do refs.append({
    'uuid': ref.uuid,
    'label': ref.label,
    'url': ref.url,
}) %}
{% endif %}
{% endfor %}
{% if refs|length > 0 %}
* 🔗 **{% trans %}External links{% endtrans %}**: {% for reference in refs %}[{{reference.label}}]({{reference.url}}){% if not loop.last %}, {% endif %}{% endfor %}
{%- endif -%}
{%- endmacro -%}
{%- macro renderExperts(question) -%}
{% set experts = [] %}
{% for expert in question.experts %}
{% if expert.name and expert.email %}
{% do experts.append({
    'uuid': expert.uuid,
    'email': expert.email,
    'name': expert.name,
}) %}
{% endif %}
{% endfor %}
{% if experts|length > 0 %}
* 🙋 **{% trans %}Experts:{% endtrans %}** {% for expert in experts %}*{{expert.name}}* <{{expert.email}}>{% if not loop.last %}, {% endif %}{% endfor %}
{%- endif -%}
{%- endmacro -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  ANSWERS MACROS                                                                      -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro renderStringValue(question, reply, path, humanIdentifier) -%}
✔️ {{reply.markdown_plain}}
{%- endmacro -%}
{%- macro renderIntegrationValue(question, reply, path, humanIdentifier) -%}
✔️ {{reply.value.value}}
{%- endmacro -%}
{%- macro renderAnswerOption(question, reply, path, humanIdentifier) -%}
{% set hi = question.answers.index(reply.answer) %}
{%- set answer = reply.answer -%}
{%- set path = path ~ "." ~ answer.uuid -%}
{%- set humanIdentifier = humanIdentifier ~ "." ~ hi|of_alphabet -%}
✔️ {{ hi|of_alphabet }}. {{answer.label}}
{% if answer.advice -%}
💡 {{answer.advice}}
{%- endif -%}
{%- if answer.followups|length > 0 -%}
{%- set hiPrefix = humanIdentifier ~ "." -%}
{%- for question in answer.followups -%}
{%- set x = loop.index -%}
{{ renderQuestion(question, path, hiPrefix ~ x) }}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- macro renderAnswerList(question, reply, path, humanIdentifier) -%}
{%- set itemPathPrefix = path ~ "." -%}
{%- set hiPrefix = humanIdentifier ~ "." -%}
{%- for i in reply.items -%}
{%- set itemPath = itemPathPrefix ~ i -%}
{%- set itemHumanIdentifier = hiPrefix ~ (loop.index - 1)|of_alphabet -%}
{%- for question in question.followups -%}
{%- set x = loop.index -%}
{{ renderQuestion(question, itemPath, itemHumanIdentifier ~ "." ~ x) }}
{%- else -%}
*{% trans %}No follow up questions{% endtrans %}*
{%- endfor -%}
{%- else %}
*{% trans %}No answer items{% endtrans %}*
{%- endfor -%}
{%- endmacro -%}
{%- macro renderAnswerChoiceList(question, reply, path, humanIdentifier) -%}
{%- for choice in question.choices -%}
{%- if choice in reply.choices %}
* ✔️ {{ choice.label }}
{%- else %}
* ❌ {{ choice.label }}
{%- endif %}
{%- endfor -%}
{%- endmacro -%}
{%- macro renderAnswerItemSelect(question, reply, path, humanIdentifier) -%}
✔️ {{ reply.item_title }}
{%- endmacro -%}
{%- macro renderAnswerFile(question, reply, path, humanIdentifier) -%}
{% if reply.file %}
✔️ [{{ reply.file.name }}]({{ reply.file.download_url }}) ({{ reply.file.size|bytesize_format }})
{% else %}
❌ {% trans %}The file has been deleted{% endtrans %}
{% endif %}
{%- endmacro -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  QUESTION MACROS                                                                     -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro renderQuestionExtras(question) -%}
{{- renderResourcePageReferences(question) -}}
{{- renderURLReferences(question) -}}
{{- renderExperts(question) -}}
{%- endmacro -%}
{%- macro renderQuestionReply(question, path, humanIdentifier) -%}
{%- set reply = question.replies.get(path) -%}
{%- if reply and reply.value -%}
{%- if question is of_type("ValueQuestion") and reply is of_type("StringReply") -%}
{{ renderStringValue(question, reply, path, humanIdentifier) }}
{%- elif question is of_type("OptionsQuestion") and reply is of_type("AnswerReply") -%}
{{ renderAnswerOption(question, reply, path, humanIdentifier) }}
{%- elif question is of_type("ListQuestion") and reply is of_type("ItemListReply") -%}
{{ renderAnswerList(question, reply, path, humanIdentifier) }}
{%- elif question is of_type("IntegrationQuestion") and reply is of_type("IntegrationReply") -%}
{{ renderIntegrationValue(question, reply, path, humanIdentifier) }}
{%- elif question is of_type("MultiChoiceQuestion") and reply is of_type("MultiChoiceReply") -%}
{{ renderAnswerChoiceList(question, reply, path, humanIdentifier) }}
{% elif question is of_type("ItemSelectQuestion") and reply is of_type("ItemSelectReply") %}
{{ renderAnswerItemSelect(question, reply, path, humanIdentifier) }}
{% elif question is of_type("FileQuestion") and reply is of_type("FileReply") %}
{{ renderAnswerFile(question, reply, path, humanIdentifier) }}
{%- endif -%}
{%- else %}
❗ *{% trans %}This question has not been answered yet!{% endtrans %}*
{%- endif -%}
{%- endmacro -%}
{%- macro renderQuestion(question, path, humanIdentifier) -%}
{%- set path = path ~ "." ~ question.uuid %}
#### {{humanIdentifier}} {{question.title}}
{{- renderTags(question) -}}
{{- renderQuestionExtras(question) -}}
{%- if question.text %}
> {{ question.text.replace("\n", "\n> ") }}
{%- endif %}
{{ renderQuestionReply(question, path, humanIdentifier) }}
{%- endmacro -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  CHAPTER MACROS                                                                      -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro renderReport(report) -%}
{%- if report.indications|length > 0 %}
### {% trans %}Summary{% endtrans %}

{% for item in report.indications -%}
* {% if item.is_for_phase %}{% trans %}Answered (current phase){% endtrans %}{% else %}{% trans %}Answered{% endtrans %}{% endif %}: **{{item.answered}} / {{item.total}}** ({{"%.2f"|format(item.percentage)}} %)
{% endfor %}
{% endif -%}
{%- if report.metrics|length > 0 %}

### {% trans %}Metrics{% endtrans %}
{% for item in report.metrics %}
* {{item.metric.title}}: {{ "%.2f"|format(item.measure) }}
{%- endfor %}
{% endif -%}
{%- endmacro -%}
{%- macro renderChapter(chapter, humanIdentifier) -%}
## {{humanIdentifier|roman}}. {{chapter.title}}

{%- if chapter.text %}
> {{chapter.text.replace("\n", "\n> ")}}
{% endif -%}

{% for chapterReport in chapter.reports %}
{{ renderReport(chapterReport) }}
{% endfor %}

### {% trans %}Questions{% endtrans %}

{% for question in chapter.questions %}
{{ renderQuestion(question, chapter.uuid, loop.index) }}
{%- else %}
*{% trans %}No questions{% endtrans %}*
{%- endfor %}
{%- endmacro -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  INTRODUCTION                                                                        -#}
{#- ------------------------------------------------------------------------------------ -#}
# {{ dc.project.name }}

* {% trans name=dc.org.name %}Organization: **{{ name }}**{% endtrans %}
{%- if dc.project.created_by %}
* {% trans first_name=dc.project.created_by.first_name, last_name=dc.project.created_by.last_name, email=dc.project.created_by.email %}Created by: **{{ first_name }} {{ last_name }}** <{{ email }}>{% endtrans %}
{%- endif %}
* {% trans name=dc.pkg.name, version=dc.pkg.version, org_id=dc.pkg.org_id, km_id=dc.pkg.km_id %}Based on: **{{ name }}, {{ version }}** (`{{ org_id }}:{{ km_id }}:{{ version }}`){% endtrans %}
{%- for version in dc.project.versions if version.uuid == dc.project.version %}
* {% trans name=version.name, date=formatDateTime(version.created_at) %}Version: **{{ name }}** ({{ date }} UTC){% endtrans %}
{%- endfor %}
{%- if dc.current_phase %}
* {% trans title=dc.current_phase.title %}Project phase: **{{ title }}**{% endtrans %}
{%- endif %}
{%- if dc.project.project_tags|length > 0 %}
* {% trans %}Project tags:{% endtrans %} {% for tag in dc.project.project_tags %}**{{ tag }}**{% if not loop.last %}, {% endif %}{% endfor %}
{%- endif %}
{%- if dc.project.description %}
* {% trans description=dc.project.description %}Description: **{{ description }}**{% endtrans %}
{%- endif %}
* {% trans date=formatDate(dc.doc.created_at) %}Created at: **{{ date }}**{% endtrans %}

## {% trans %}Report{% endtrans %}

{{ renderReport(dc.report.total_report) }}

{% if dc.project.versions|length > 0 %}
## {% trans %}History of Versions{% endtrans %}

{% trans %}The named versions of this document:{% endtrans %}

{%- for version in dc.project.versions|reverse %}
* **{{ version.name }}** ({{ formatDate(version.created_at) }}): {{ version.description }}
{%- endfor %}
{%- endif %}

---

{% for chapter in dc.km.chapters %}
{{ renderChapter(chapter, loop.index) }}
{% else %}
*{% trans %}No chapters{% endtrans %}*
{% endfor %}
{% endautoescape %}
