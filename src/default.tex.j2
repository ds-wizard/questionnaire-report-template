{#- ------------------------------------------------------------------------------------ -#}
{#-  VARIABLES                                                                           -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- set dc = ctx|to_context_obj -%}
{%- from "src/dates.j2" import formatDate, formatDateTime -%}
{#- LaTeX output: no HTML escaping, values from the context are escaped by tex() instead -#}
{%- autoescape false -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  LATEX ESCAPING                                                                      -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro tex(value) -%}
{{- (value if value is not none else "")|string
    |replace("\\", "@@QR-BACKSLASH@@")
    |replace("{", "\\{")
    |replace("}", "\\}")
    |replace("@@QR-BACKSLASH@@", "\\textbackslash{}")
    |replace("&", "\\&")
    |replace("%", "\\%")
    |replace("$", "\\$")
    |replace("#", "\\#")
    |replace("_", "\\_")
    |replace("~", "\\textasciitilde{}")
    |replace("^", "\\textasciicircum{}") -}}
{%- endmacro -%}
{%- macro url(value) -%}
{{- (value if value is not none else "")|string
    |replace("\\", "/")
    |replace("%", "\\%")
    |replace("#", "\\#")
    |replace("{", "%7B")
    |replace("}", "%7D") -}}
{%- endmacro -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  ANSWERS MACROS                                                                      -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro renderAnswerValue(question, reply, path, humanIdentifier) %}
{%- if reply is of_type("StringReply") %}
\begin{answerbox}
{%- if question.value_type == "UrlQuestionValueType" %}
\url{ {{- url(reply.value) -}} }
{%- else %}
{{ tex(reply.markdown_plain) }}
{%- endif %}
\end{answerbox}
{% else %}
\begin{answerbox}
\begin{markdown}
{{ reply.value.split("![]", 1)[0] }}
\end{markdown}
{%- if reply.is_legacy_integration %}
{%- set integration = question.integration %}
\href{ {{- url(integration.item(reply.item_id)) -}} }{({{ tex(integration.name) }}: {{ tex(reply.item_id) }})}
{%- endif %}
\end{answerbox}
{% endif -%}
{%- endmacro -%}
{%- macro renderAnswerOption(question, reply, path, humanIdentifier) -%}
{%- set hi = question.answers.index(reply.answer) -%}
{%- set answer = reply.answer -%}
{%- set path = path ~ "." ~ answer.uuid -%}
{%- set humanIdentifier = humanIdentifier ~ "." ~ hi|of_alphabet %}
\begin{answerbox}
{{ hi|of_alphabet }}. {{ tex(answer.label) }}
\end{answerbox}

{% if answer.advice -%}
\begin{advicebox}
\begin{markdown}
{{answer.advice}}
\end{markdown}
\end{advicebox}
{%- endif %}

{% if answer.followups|length > 0 -%}
{%- set hiPrefix = humanIdentifier ~ "." -%}
{%- for question in answer.followups -%}
{%- set x = loop.index -%}
{{ renderQuestion(question, path, hiPrefix ~ x) }}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- macro renderAnswerList(question, reply, path, humanIdentifier) -%}
{%- set itemPathPrefix = path ~ "." -%}
{%- set hiPrefix = humanIdentifier ~ "." %}
\sectionlabel{ {%- trans count=reply.items|length %}Answered with {{ count }} item as follows.{% pluralize %}Answered with {{ count }} items as follows.{% endtrans %}}
{%- for i in reply.items -%}
{%- set itemPath = itemPathPrefix ~ i -%}
{%- set itemHumanIdentifier = hiPrefix ~ (loop.index - 1)|of_alphabet %}
% Answer item: {{itemPath}}
\answeritem{ {{- itemHumanIdentifier -}} }
{%- for question in question.followups -%}
  {%- set x = loop.index -%}
{{ renderQuestion(question, itemPath, itemHumanIdentifier ~ "." ~ x) }}
{% else %}
\noanswer{ {%- trans %}No follow up questions{% endtrans %}}
{% endfor %}
{% endfor %}
{%- endmacro -%}
{%- macro renderAnswerChoiceList(question, reply, path, humanIdentifier) -%}
{%- if question.choices|length > 0 %}
\begin{answerbox}
\begin{itemize}[leftmargin=1.6em, nosep, label={}]
{%- for choice in question.choices -%}
{%- if choice in reply.choices %}
  \item[\textcolor{qrAccent}{$\blacksquare$}] {{ tex(choice.label) }}
{%- else %}
  \item[\textcolor{qrLight}{$\square$}] \textcolor{qrLight}{\mdseries {{ tex(choice.label) }}}
{%- endif -%}
{%- endfor %}
\end{itemize}
\end{answerbox}
{%- endif %}
{%- endmacro -%}
{%- macro renderAnswerItemSelect(question, reply, path, humanIdentifier) -%}
\begin{answerbox}
{{ tex(reply.item_title) }}
\end{answerbox}
{%- endmacro -%}
{%- macro renderAnswerFile(question, reply, path, humanIdentifier) -%}
{% if reply.file %}
\begin{answerbox}
\href{ {{- url(reply.file.download_url) -}} }{ {{- tex(reply.file.name) -}} } ({{ tex(reply.file.size|bytesize_format) }})
\end{answerbox}
{% else %}
\noanswer{ {%- trans %}The file has been deleted{% endtrans %}}
{% endif %}
{%- endmacro -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  QUESTION REPLY MACROS                                                               -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro renderQuestionReply(question, path, humanIdentifier) -%}
  {%- set isRequired = question.is_required -%}
  {%- set reply = question.replies.get(path) -%}
  {%- if reply and reply.value -%}
    {%- if question is of_type("ValueQuestion") and reply is of_type("StringReply") -%}
      {{ renderAnswerValue(question, reply, path, humanIdentifier) }}
    {%- elif question is of_type("OptionsQuestion") and reply is of_type("AnswerReply") -%}
      {{ renderAnswerOption(question, reply, path, humanIdentifier) }}
    {%- elif question is of_type("ListQuestion") and reply is of_type("ItemListReply") -%}
      {{ renderAnswerList(question, reply, path, humanIdentifier) }}
    {%- elif question is of_type("IntegrationQuestion") and reply is of_type("IntegrationReply") -%}
      {{ renderAnswerValue(question, reply, path, humanIdentifier) }}
    {%- elif question is of_type("MultiChoiceQuestion") and reply is of_type("MultiChoiceReply") -%}
      {{ renderAnswerChoiceList(question, reply, path, humanIdentifier) }}
    {% elif question is of_type("ItemSelectQuestion") and reply is of_type("ItemSelectReply") %}
      {{ renderAnswerItemSelect(question, reply, path, humanIdentifier) }}
    {% elif question is of_type("FileQuestion") and reply is of_type("FileReply") %}
      {{ renderAnswerFile(question, reply, path, humanIdentifier) }}
    {%- endif -%}
  {% else %}
\{{ "noanswerrequired" if isRequired else "noanswer" }}{ {%- trans %}This question has not been answered yet!{% endtrans %}}
  {% endif -%}
{%- endmacro -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  QUESTION EXTRAS MACRO                                                               -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro renderQuestionTags(question) -%}
  {%- if question.tags|length > 0 %}
\noindent{% for tag in question.tags %}{% set color = tag.color[1:] if tag.color[0] == "#" else tag.color %}\qtag{ {{- color -}} }{ {{- tex(tag.name) -}} }{% if not loop.last %} {% endif %}{% endfor %}\par
  {%- endif %}
{%- endmacro -%}
{%- macro renderQuestionExtras(question) -%}
  {%- set resourcePageReferences = question.resource_page_references -%}
  {%- set urlReferences = question.url_references -%}
  {%- set experts = question.experts -%}
  {%- if resourcePageReferences|length > 0 or urlReferences|length > 0 or experts|length > 0 %}
\begin{questionmeta}
  {%- if resourcePageReferences|length > 0 %}
  \item \textbf{ {%- trans %}Resource Pages{% endtrans %}}: {% for reference in resourcePageReferences -%}
  {%- if reference.resource_page_uuid and reference.resource_page and reference.resource_page.collection -%}
    {%- set resourcePageLink = dc.config.client_url ~ '/knowledge-models/' ~ dc.pkg.id ~ '/resource-pages/' ~ reference.resource_page.uuid -%}
    \href{ {{- url(resourcePageLink) -}} }{ {{- tex(reference.resource_page.collection.title) }} -- {{ tex(reference.resource_page.title) -}} }
    {%- if not loop.last -%}, {% endif -%}{%- endif -%}{%- endfor -%}
  {%- endif -%}
  {%- if urlReferences|length > 0 %}
  \item \textbf{ {%- trans %}External Links{% endtrans %}}: {% for reference in urlReferences -%}
    \href{ {{- url(reference.url) -}} }{ {{- tex(reference.label) -}} }
    {%- if not loop.last -%}, {% endif -%}{%- endfor -%}
  {%- endif -%}
  {% if experts|length > 0 %}
  \item \textbf{ {%- trans %}Experts{% endtrans %}}: {% for expert in experts -%}
    {{ tex(expert.name) }} $\langle$\href{mailto:{{ url(expert.email) }}}{ {{- tex(expert.email) -}} }$\rangle$
    {%- if not loop.last -%}, {% endif -%}{%- endfor -%}
  {%- endif %}
\end{questionmeta}
  {%- endif -%}
{%- endmacro -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  QUESTION MACROS                                                                     -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro renderQuestion(question, path, humanIdentifier) -%}
{%- set path = path ~ "." ~ question.uuid -%}
{#- I.1 = question of a chapter, each further ".a.1" one level of follow-ups deeper -#}
{%- set depth = ((humanIdentifier|string).count(".") - 1) // 2 -%}
{%- set command = ["section", "subsection", "subsubsection"][[depth, 2]|min] %}
\{{ command }}*{\qnumber{ {{- humanIdentifier -}} }{{ tex(question.title) }}}
{%- if depth == 0 %}
\addcontentsline{toc}{section}{ {{- humanIdentifier }} {{ tex(question.title) -}} }
{%- endif %}
\label{ {{- path -}} }
% uuid: {{question.uuid}}
% path: {{path}}
{{ renderQuestionTags(question) }}
{% if question.text %}
\begin{questiontext}
\begin{markdown}
{{question.text}}
\end{markdown}
\end{questiontext}
{% endif %}
{{ renderQuestionExtras(question) }}

{{ renderQuestionReply(question, path, humanIdentifier) }}

{%- endmacro -%}
{#- ------------------------------------------------------------------------------------ -#}
{#-  REPORT MACROS                                                                       -#}
{#- ------------------------------------------------------------------------------------ -#}
{%- macro progressBar(value, scale=false) -%}
{%- set color = "qrAccent" -%}
{%- if scale -%}
{%- set color = "qrScale" ~ ((value * 10)|int) -%}
{%- endif -%}
\progressbar[width=0.36\linewidth, heighta=5pt, subdivisions=1, borderwidth=0pt, linecolor=qrBar, emptycolor=qrBar, filledcolor={{color}}, roundnessr=0.2]{ {{- value -}} }
{%- endmacro -%}
{%- macro renderReport(report) -%}
\begin{reportbox}
\begin{tabularx}{\linewidth}{@{}X r l@{}}
{%- for item in report.indications %}
  {% if item.is_for_phase %}{% trans %}Answered (current phase){% endtrans %}{% else %}{% trans %}Answered{% endtrans %}{% endif %} & \textcolor{qrMuted}{ {{- item.answered }} / {{ item.total -}} } & {{ progressBar(item.percentage) }} \\
{%- endfor %}
{%- if report.metrics|length > 0 %}
  \midrule
  \metalabel{ {%- trans %}Metric{% endtrans %}} & \metalabel{ {%- trans %}Score{% endtrans %}} & \\
{%- for item in report.metrics %}
  {{ tex(item.metric.title) }} & \textcolor{qrMuted}{ {{- "%.2f"|format(item.measure) -}} } & {{ progressBar(item.measure, scale=true) }} \\
{%- endfor -%}
{%- endif %}
\end{tabularx}
\end{reportbox}
{%- endmacro -%}
{%- macro renderVersions() -%}
{% if dc.project.versions|length > 0 %}
\section*{ {%- trans %}History of Versions{% endtrans %}}

\noindent
\begin{tabularx}{\linewidth}{@{}l l X@{}}
  \toprule
  \metalabel{ {%- trans %}Version{% endtrans %}} & \metalabel{ {%- trans %}Date{% endtrans %}} & \metalabel{ {%- trans %}Description{% endtrans %}} \\
  \midrule
{%- for version in dc.project.versions|reverse %}
  \textbf{ {{- tex(version.name) -}} } & \textcolor{qrMuted}{ {{- formatDate(version.created_at) -}} } & {{ tex(version.description) }} \\
{%- endfor %}
  \bottomrule
\end{tabularx}
{% endif %}
{%- endmacro -%}
